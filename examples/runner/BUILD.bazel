load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//build:defs.bzl", "bazel_runner_image", "github_actions_runner_image", "gitlab_ci", "gitlab_job")

package(default_visibility = ["//visibility:public"])

# A base bazel CI runner image (bazelisk pinned to bazel 7.4.1 on
# distroless/cc). `bazel run :runner_tarball` loads it locally;
# `bazel run :runner_push -- --tag <sha>` pushes it.
bazel_runner_image(
    name = "runner",
    bazel_version = "7.4.1",
    repository = "ghcr.io/fastverk/bazel-runner",
)

# Linux GitHub Actions runner image: same pinned Bazel surface, separate
# published repo so reusable workflows can share one image reference.
github_actions_runner_image(
    name = "github_actions_runner",
    bazel_version = "7.4.1",
)

_BOOTSTRAP_BAZELISK = [
    "apt-get update",
    "apt-get install -y --no-install-recommends ca-certificates curl git",
    "curl -fsSL -o /usr/local/bin/bazelisk https://github.com/bazelbuild/bazelisk/releases/download/v1.25.0/bazelisk-linux-amd64",
    "chmod +x /usr/local/bin/bazelisk",
    "ln -sf /usr/local/bin/bazelisk /usr/local/bin/bazel",
]

# CI-generation surface, re-exported from rules_gitlab. The published
# runner image is distroless, so a GitLab pipeline must bootstrap from a
# shell-full image first rather than selecting the runner image as the
# executor image directly.
gitlab_ci(
    name = "ci",
    stages = ["test"],
    jobs = {
        "test": gitlab_job(
            stage = "test",
            image = "debian:12-slim",
            before_script = _BOOTSTRAP_BAZELISK,
            script = ["bazel test //..."],
        ),
    },
)

build_test(
    name = "smoke",
    targets = [
        ":runner",
        ":runner_tarball",
        ":github_actions_runner",
        ":github_actions_runner_tarball",
        ":ci",
        ":ci_validate",
    ],
)
