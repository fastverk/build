load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//build:defs.bzl", "bazel_runner_image", "github_actions_runner_image", "gitlab_ci", "gitlab_job")

package(default_visibility = ["//visibility:public"])

# A base bazel CI runner image (bazelisk pinned to bazel 7.4.1 on
# distroless/cc). `bazel run :runner_tarball` loads it locally;
# `bazel run :runner_push -- --tag <sha>` pushes it.
bazel_runner_image(
    name = "runner",
    bazel_version = "7.4.1",
    repository = "ghcr.io/fastverk/bazel-runner",
)

# Linux GitHub Actions runner image: same pinned Bazel surface, separate
# published repo so reusable workflows can share one image reference.
github_actions_runner_image(
    name = "github_actions_runner",
    bazel_version = "7.4.1",
)

# CI-generation surface, re-exported from rules_gitlab. Mirror the
# studio pattern: bootstrap with the Bazel container image directly
# rather than trying to execute the published distroless runner image as
# the GitLab job container.
gitlab_ci(
    name = "ci",
    stages = ["test"],
    image = {
        "name": "gcr.io/bazel-public/bazel:8.2.1",
        "entrypoint": [""],
    },
    jobs = {
        "test": gitlab_job(
            stage = "test",
            script = ["bazel test //..."],
        ),
    },
)

build_test(
    name = "smoke",
    targets = [
        ":runner",
        ":runner_tarball",
        ":github_actions_runner",
        ":github_actions_runner_tarball",
        ":ci",
        ":ci_validate",
    ],
)
